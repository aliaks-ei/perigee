# Perigee build flags.

# Compressed (KTX2/Basis) textures. Run ./scripts/textures.sh first, then set
# this to 1 and rebuild. Off by default: with no .ktx2 files present the loader
# would fall back on every texture anyway, and the transcoder would be shipped
# for nothing.
VITE_KTX2_TEXTURES=0

# The public origin, used to build absolute Open Graph URLs for the curated
# encounter routes. Without it the cards fall back to root-relative paths,
# which social crawlers resolve unreliably.
NUXT_PUBLIC_SITE_URL=https://perigee.observer

# Umami analytics. Leave the id empty to disable measurement entirely: the
# script is then never requested and no third-party call is made. Set it only
# in the production build environment.
NUXT_PUBLIC_UMAMI_WEBSITE_ID=
# Override only when self-hosting Umami; defaults to Umami Cloud.
NUXT_PUBLIC_UMAMI_SRC=
